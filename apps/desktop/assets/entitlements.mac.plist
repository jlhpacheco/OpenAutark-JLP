<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened runtime for Autark (Electron). One file for the app and every helper (entitlementsInherit).
         Developer ID build: nothing more is needed. Every Mach-O file inside (Electron Framework, the sherpa-onnx .node
         and .dylib files unpacked from the asar) is signed with the same certificate, so library validation passes. -->
    <!-- V8 compiles JavaScript and WebAssembly (onnxruntime-web) to machine code at run time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Microphone: calls with agents, dictation, the floating to-do button (getUserMedia audio). Without this entitlement
         the hardened runtime hands the app silence and macOS never asks. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Camera: only workspace apps that ask for permissions="microphone,camera". -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- osascript tells Terminal to run the engine sign-in (runtime/accounts/terminal-login.ts). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
